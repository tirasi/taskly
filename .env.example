# ---- General ----
APP_TZ=Asia/Kolkata          # "today" and reminder times are computed in this timezone
DEBUG=1                      # 1 = show the "simulate email" box and dev endpoint. Use 0 in production.

# ---- Cloud AI for voice (optional; without these the app falls back to browser speech + local rules) ----
ANTHROPIC_API_KEY=           # understands spoken commands (Claude, forced tool call -> structured JSON)
ANTHROPIC_MODEL=claude-haiku-5-5
STT_API_KEY=                 # speech-to-text; any OpenAI-compatible /audio/transcriptions endpoint
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1          # e.g. whisper-large-v3-turbo if STT_BASE_URL is Groq

# ---- Email-to-comment ----
EMAIL_DOMAIN=inbox.example.com     # every task gets t-<token>@this-domain
INBOUND_SECRET=change-me           # your mail provider's webhook must send this (header X-Inbound-Secret or ?secret=)
